# --- Kept OUT of git (S3-only, uploaded manually via upload-audio helper) ---
# Large/private media. These live only on S3 + your local drive, never in the repo.
audio/
videos/
downloads/

# --- Build output (generated by build_s3_site.py; never commit) ---
build/

# --- OS / editor junk ---
.DS_Store
.vscode/settings.json

# NOTE: images/, fonts/, transgender/, css/ are now VERSIONED in git
# (they are public assets served on the site; versioning them gives you
#  changelog + history and lets `git push` auto-deploy image changes).
